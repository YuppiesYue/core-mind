# Auto Car Agent Service 环境变量配置
# 复制本文件为 .env 并填入实际值

# ─── LLM 配置 ───
LLM_PROVIDER=openai          # dashscope / openai / deepseek
LLM_MODEL=qwen-max
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=                   # 仅 openai/deepseek 需要
LLM_STREAM=true
LLM_ENABLE_THINKING=true          # true / false，是否开启模型 think（推理）模式
LLM_CONTEXT_SIZE=131072

# ─── 服务配置 ───
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Agent 配置 ───
AGENT_NAME=智能助手
AGENT_MAX_ITERS=20

# ─── AgentScope 会话记忆（默认开启） ───
# true 时，/chat 会基于 userId + sessionId 复用 AgentScope 2.0 的会话上下文。
AGENT_ENABLE_SESSION_MEMORY=true

# ─── MCP 服务 ───
# 传输模式：stdio（默认，本地开发，不占端口）或 http（生产环境，需独立部署 MCP server）
MCP_TRANSPORT=http
# stdio 模式下可自定义 python 路径（默认 python）
# MCP_PYTHON=python
# http 模式下可自定义 MCP server URL（仅 MCP_TRANSPORT=http 时生效）
CAR_DATA_MCP_URL=http://auto-car-agent.autohome.com.cn/mcp-data/mcp
CAR_CARD_MCP_URL=http://auto-car-agent.autohome.com.cn/mcp-card/mcp
CARD_PARAM_DIMS_API_URL=http://auto-car-agent.autohome.com.cn/api/v1/param-dims/list
